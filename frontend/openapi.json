  "components": {
    "schemas": {
      "CityOut": {
        "properties": {
          "id": { "type": "string", "title": "Id" },
          "name": { "type": "string", "title": "Name" }
        },
        "type": "object",
        "required": ["id", "name"],
        "title": "CityOut"
      },
      "EmailSignupIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Name"
          },
          "email": { "type": "string", "maxLength": 254, "title": "Email" },
          "password": {
            "type": "string",
            "maxLength": 128,
            "title": "Password"
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "title": "Birthdate"
          },
          "cityId": { "type": "integer", "title": "Cityid" },
          "invite": {
            "anyOf": [
              { "type": "string", "maxLength": 64 },
              { "type": "null" }
            ],
            "title": "Invite"
          }
        },
        "type": "object",
        "required": ["name", "email", "password", "birthDate", "cityId"],
        "title": "EmailSignupIn",
        "description": "Cadastro por e-mail e senha (A02, #51).\n\nO front manda em camelCase (birthDate, cityId). O formato do e-mail, o\ntamanho m\u00ednimo da senha, a idade, a cidade e o convite s\u00e3o conferidos no\nservi\u00e7o, que devolve um c\u00f3digo que o front sabe mostrar junto ao campo.\nAqui ficam s\u00f3 os limites que protegem o servidor."
      },
      "GoogleSignupCompleteIn": {
        "properties": {
          "birthDate": {
            "type": "string",
            "format": "date",
            "title": "Birthdate"
          },
          "cityId": { "type": "integer", "title": "Cityid" },
          "withoutInvite": {
            "type": "boolean",
            "title": "Withoutinvite",
            "default": false
          }
        },
        "type": "object",
        "required": ["birthDate", "cityId"],
        "title": "GoogleSignupCompleteIn",
        "description": "O que falta no cadastro pelo Google: data de nascimento e cidade (A02b).\n\nNome e e-mail v\u00eam do Google, pelo cookie do cadastro pendente, e n\u00e3o daqui."
      },
      "GroupOrigin": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "group",
            "title": "Kind",
            "default": "group"
          },
          "groupName": { "type": "string", "title": "Groupname" }
        },
        "type": "object",
        "required": ["groupName"],
        "title": "GroupOrigin",
        "description": "Ela veio pelo convite de um grupo (M1): a lideran\u00e7a dele v\u00ea os dados dela (RN-01)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InterestOptionsOut": {
        "properties": {
          "topics": {
            "items": { "$ref": "#/components/schemas/OptionOut" },
            "type": "array",
            "title": "Topics"
          },
          "stages": {
            "items": { "$ref": "#/components/schemas/OptionOut" },
            "type": "array",
            "title": "Stages"
          }
        },
        "type": "object",
        "required": ["topics", "stages"],
        "title": "InterestOptionsOut",
        "description": "As listas de temas e de etapas de estudo da A05 (RF-F10.01)."
      },
      "InterestsIn": {
        "properties": {
          "topics": {
            "items": { "$ref": "#/components/schemas/Topic" },
            "type": "array",
            "maxItems": 8,
            "title": "Topics"
          },
          "everything": { "type": "boolean", "title": "Everything" },
