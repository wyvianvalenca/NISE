# Local database (Docker)
POSTGRES_USER=nise
POSTGRES_PASSWORD=nise
POSTGRES_DB=nise
POSTGRES_PORT=5432

# Conection used by back-end (async driver)
# If you changed the POSTGRES_PORT, also change the port here
DATABASE_URL=postgresql+asyncpg://nise:nise@localhost:5432/nise


# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
COOKIE_SECURE=false


# Login com Google (console.cloud.google.com > APIs e serviços > Credenciais)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback


# Endereço público do app, usado nos links dos e-mails (ex.: recuperar a senha).
APP_URL=http://localhost:3000

# Busca em listas oficiais (F31). Fica desligada até o Comitê de Ética aprovar
# (RN-20); só mude para true depois disso.
LIST_SEARCH_ENABLED=false
# Os endereços mudam a cada edição do Sisu; sem estas variáveis, valem os da
# edição 2026 (backend/app/config.py).
# COPEVE_REPORT_URL=
# COPEVE_PUBLIC_URL=
# COPEVE_SELECTION_PROCESS=
# Seleções do IFAL na API pública (número: processo seletivo), em JSON. Vazio
# não busca no IFAL. Ex.: IFAL_SELECTIONS={"123": "SiSU 2027"}
# IFAL_SELECTIONS=
# IFAL_TARGET_COURSES=[["Sistemas de Informação", "Maceió"]]
# Segredo que o agendador da hospedagem manda nas rotas /api/cron. Vazio recusa tudo.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=


# E-mails automáticos pela conta Gmail da equipe (SMTP com STARTTLS).
# SMTP_PASSWORD é uma senha de app do Google (myaccount.google.com > Segurança >
# Senhas de app), não a senha da conta. Sem SMTP_USER e SMTP_PASSWORD, nenhum
# e-mail sai: eles esperam na fila.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente, ex.: NISE <conta@gmail.com>. Vazio usa o SMTP_USER.
EMAIL_FROM=
