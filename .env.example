# Local database (Docker)
POSTGRES_USER=nise
POSTGRES_PASSWORD=nise
POSTGRES_DB=nise
POSTGRES_PORT=5432

# Conection used by back-end (async driver)
# If you changed the POSTGRES_PORT, also change the port here
DATABASE_URL=postgresql+asyncpg://nise:nise@localhost:5432/nise


# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
COOKIE_SECURE=false


# Login com Google (console.cloud.google.com > APIs e serviços > Credenciais)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback


# Endereço público do app, usado nos links dos e-mails (ex.: recuperar a senha).
APP_URL=http://localhost:3000

# Busca em listas oficiais (F31). Os endereços mudam a cada edição do Sisu;
# sem estas variáveis, valem os da edição 2026 (backend/app/config.py).
# COPEVE_REPORT_URL=
# COPEVE_PUBLIC_URL=
# COPEVE_SELECTION_PROCESS=
# Segredo que o agendador da hospedagem manda nas rotas /api/cron. Vazio recusa tudo.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
